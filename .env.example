# Live Show Radar — environment template (placeholders only; never commit real values).
# Copy to .env.local for local dev; set the same names in Vercel → Project → Settings → Environment Variables.
# EVERY variable is server-only: none is prefixed NEXT_PUBLIC_, so none reaches the browser bundle.
# Nothing here is needed to BUILD. Anything unset shows as "not configured" in the app — never as working.

# ── Core runtime (needed for server storage, inbox and monitoring) ──────────
# Least-privilege role connection string. Generate with:
#   npm run db:create-role -- <supabase-project-ref> <pooler-host>
# Port picks the pooler mode:  :6543 transaction mode → Vercel/serverless (app uses 1 connection)
#                              :5432 session mode     → local dev / long-running servers
DATABASE_URL=postgresql://lsr_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Signs the anonymous profile cookie. 32+ random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ── Scheduled monitoring (Part 4) ────────────────────────────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/monitor (see vercel.json).
# Unset → the cron route refuses to run (503).
CRON_SECRET=
# Bearer token for operator endpoints: POST /api/admin/discovery, GET /api/admin/status. Unset → disabled.
DISCOVERY_ADMIN_TOKEN=
# Early-bird reminder windows, hours before a VERIFIED deadline (default 72,24).
# REMINDER_WINDOWS_HOURS=72,24

# ── Gemini Flash (Google AI Studio → https://aistudio.google.com/apikey) ─────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: used only after the primary model's retries fail. Never another provider.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# ── Event sources ─────────────────────────────────────────────────────────────
# MusicBrainz needs no key, but asks for contact info in the User-Agent (email or URL).
MUSICBRAINZ_CONTACT=
# MUSICBRAINZ_ENABLED=true          # false → artist search falls back to the labelled sample catalogue
# TICKETMASTER_API_KEY=             # https://developer.ticketmaster.com (adapter untested: no key yet)
# BANDSINTOWN_APP_ID=               # granted to artists/partners via API@bandsintown.com

# ── Email alerts (optional; Resend — https://resend.com) ─────────────────────
# All three are required. EMAIL_FROM must be a sender on a domain verified in Resend.
# Until address verification (double opt-in) exists, email ONLY goes to allow-listed addresses.
# RESEND_API_KEY=
# EMAIL_FROM=Live Show Radar <alerts@your-verified-domain.example>
# EMAIL_ALLOWED_RECIPIENTS=you@example.com

# ── Planned (not implemented; setting these does nothing yet) ────────────────
# APP_BASE_URL=http://127.0.0.1:3003
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3003/api/integrations/spotify/callback
